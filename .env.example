# Local Supabase values from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key

# Optional Gmail OAuth for reading recent OTP email from explicitly approved publishers.
# Create a Google OAuth web client and register this exact redirect URI.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=
